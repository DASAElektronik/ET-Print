<Window x:Class="ETPrinter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ETPrinter.ViewModels"
        xmlns:controls="clr-namespace:ETPrinter.Controls"
        xmlns:converters="clr-namespace:ETPrinter.Converters"
        Title="{Binding WindowTitle}"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Bruecke fuer Elemente ausserhalb des Visual Trees (ContextMenu, RowDefinition) -->
        <converters:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"/>
        <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}"/>
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}"/>
        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}"/>
        <KeyBinding Gesture="Ctrl+PageDown" Command="{Binding NextPageCommand}"/>
        <KeyBinding Gesture="Ctrl+PageUp" Command="{Binding PrevPageCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Gesture="F5" Command="{Binding PrintCommand}"/>
        <KeyBinding Gesture="Ctrl+0" Command="{Binding FitZoomCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding ClearSelectedCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Neu" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Oeffnen..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Speichern" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Speichern _unter..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="Zuletzt geoeffnet" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding DisplayName}"/>
                            <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding FilePath}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Importieren">
                    <MenuItem Header="CSV-Datei..." Command="{Binding ImportCsvCommand}"
                              ToolTipService.ShowOnDisabled="True"
                              ToolTip="Nur fuer ET 200SP-Etiketten (Kopfzeile / Zeile 1 / Zeile 2). Im ET200MP-Modus nicht verfuegbar."/>
                    <MenuItem Header="Excel-Datei (.xlsx)..." Command="{Binding ImportExcelCommand}"
                              ToolTipService.ShowOnDisabled="True"
                              ToolTip="Nur fuer ET 200SP-Etiketten (Kopfzeile / Zeile 1 / Zeile 2). Im ET200MP-Modus nicht verfuegbar."/>
                    <MenuItem Header="PDF-Schaltplan..." Command="{Binding ImportSchematicCommand}"
                              ToolTip="Module und Adressen aus einem Schaltplan-PDF; ET200MP: je Modul ein Streifen ab dem ausgewaehlten Modul."/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Drucken..." Command="{Binding PrintCommand}" InputGestureText="Ctrl+P"/>
                <MenuItem Header="Nur aktuelle Seite drucken..." Command="{Binding PrintCurrentPageCommand}"/>
                <Separator/>
                <MenuItem Header="_Beenden" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Bearbeiten">
                <MenuItem Header="Auswahl _leeren" Command="{Binding ClearSelectedCommand}" InputGestureText="Entf"/>
                <MenuItem Header="Alle _loeschen" Command="{Binding ClearAllCommand}"/>
                <Separator/>
                <MenuItem Header="Druckauswahl">
                    <MenuItem Header="Alle drucken" Command="{Binding SelectAllForPrintCommand}"/>
                    <MenuItem Header="Keine drucken" Command="{Binding DeselectAllForPrintCommand}"/>
                    <MenuItem Header="Nur befuellte drucken" Command="{Binding SelectFilledForPrintCommand}"/>
                    <Separator/>
                    <MenuItem Header="Ausgewaehltes Etikett/Modul umschalten" Command="{Binding TogglePrintCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="_Info" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1">
            <Button Command="{Binding NewProjectCommand}" ToolTip="Neues Projekt (Ctrl+N)">
                <TextBlock Text="Neu" Margin="5,0"/>
            </Button>
            <Button Command="{Binding OpenCommand}" ToolTip="Oeffnen (Ctrl+O)">
                <TextBlock Text="Oeffnen" Margin="5,0"/>
            </Button>
            <Button Command="{Binding SaveCommand}" ToolTip="Speichern (Ctrl+S)">
                <TextBlock Text="Speichern" Margin="5,0"/>
            </Button>
            <Separator/>
            <Button Command="{Binding CopyCommand}" ToolTip="Kopieren (Ctrl+C)">
                <TextBlock Text="Kopieren" Margin="5,0"/>
            </Button>
            <Button Command="{Binding PasteCommand}" ToolTip="Einfuegen (Ctrl+V)">
                <TextBlock Text="Einfuegen" Margin="5,0"/>
            </Button>
            <Separator/>
            <Button Command="{Binding PrintCommand}" ToolTip="Drucken (Ctrl+P)">
                <TextBlock Text="Drucken" Margin="5,0" FontWeight="Bold"/>
            </Button>
        </ToolBar>

        <!-- Main Content - 2 Spalten -->
        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="300" MinWidth="200" MaxWidth="800"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- LINKS: Eingabe-Panel -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5">

                    <!-- Ausgewaehltes Etikett -->
                    <GroupBox Margin="0,0,0,10">
                        <GroupBox.Header>
                            <TextBlock>
                                <Run Text="Bearbeite: " FontWeight="Bold"/>
                                <Run Text="{Binding EditTargetInfo, Mode=OneWay}" Foreground="#0078D4"/>
                            </TextBlock>
                        </GroupBox.Header>
                        <StackPanel Margin="5">
                            <TextBlock FontSize="11" Foreground="Gray">
                                <Run Text="Format: "/>
                                <Run Text="{Binding SelectedFormat.DisplayName, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="Gray" Text="{Binding LayoutInfo, Mode=OneWay}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Produktfamilie + Druckformat -->
                    <GroupBox Header="Produktfamilie / Druckformat" Margin="0,0,0,10">
                        <StackPanel Margin="5">
                            <Label Content="Produktfamilie:" Padding="0" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding AvailableProductFamilies}"
                                      SelectedItem="{Binding SelectedProductFamilyInfo}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,8"/>
                            <Label Content="Druckformat:" Padding="0" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding AvailableFormats}"
                                      SelectedItem="{Binding SelectedFormat}"
                                      DisplayMemberPath="DisplayName"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Etikett-Eingabe als Tabs -->
                    <TabControl Margin="0,0,0,10"
                                IsEnabled="{Binding HasSelection}"
                                SelectedIndex="{Binding InputTabIndex}">

                        <!-- Tab 1: Adress-Generator -->
                        <TabItem Header="Adress-Generator">
                            <StackPanel Margin="5">
                                <!-- Modulname -->
                                <Label Content="Modulname (Kopfzeile):" Padding="0" Margin="0,4,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding GenModuleName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Aendern"
                                            Command="{Binding UpdateHeaderCommand}"
                                            ToolTip="Nur Kopfzeile des ausgewaehlten Etiketts aendern"
                                            Padding="6,1" Margin="4,0,0,0" FontSize="11"/>
                                </Grid>

                                <!-- Modultyp -->
                                <Label Content="Modultyp:" Padding="0" Margin="0,8,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableModuleTypes}"
                                          SelectedItem="{Binding GenModuleType}"
                                          DisplayMemberPath="DisplayName"/>

                                <!-- Startadresse -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Content="Start-Byte:" Padding="0" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding GenStartByte, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Enter = Generieren + Uebertragen">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding GenerateAndApplyCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="{Binding GenCountLabel}" Padding="0" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding GenTypicalCounts}"
                                                  SelectedItem="{Binding GenCount}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Auto-Weiterschalten -->
                                <CheckBox Content="Startadresse automatisch weiterschalten"
                                          IsChecked="{Binding GenAutoAdvanceAddress}"
                                          Margin="0,8,0,0" FontSize="11"/>

                                <!-- Vorschau -->
                                <Border Background="#F8F8F0" BorderBrush="#D0D0C0" BorderThickness="1"
                                        CornerRadius="3" Margin="0,8,0,0" Padding="5">
                                    <StackPanel>
                                        <TextBlock Text="Vorschau:" FontWeight="SemiBold" FontSize="10" Foreground="Gray"/>
                                        <TextBlock Text="{Binding GenPreviewLine1}" FontSize="10"
                                                   Foreground="#1A237E" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding GenPreviewLine2}" FontSize="10"
                                                   Foreground="#37474F" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Generieren + Uebertragen -->
                                <Button Content="Generieren + Uebertragen"
                                        Command="{Binding GenerateAndApplyCommand}"
                                        FontWeight="Bold"
                                        Padding="10,8"
                                        Background="#107C10"
                                        Foreground="White"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab 2: Manuelle Eingabe (nur ET200SP; MP hat den Modul-Editor) -->
                        <TabItem Header="Manuell"
                                 Visibility="{Binding IsModuleBased, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel Margin="5">
                                <!-- Header (nur bei +Header Formaten) -->
                                <StackPanel Visibility="{Binding HasHeader,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Label Content="Kopfzeile:" Padding="0" Margin="0,4,0,2"/>
                                    <TextBox Text="{Binding InputHeader, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ApplyCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </StackPanel>

                                <!-- Zeile 1 -->
                                <Label Content="Zeile 1:" Padding="0" Margin="0,4,0,2"/>
                                <TextBox x:Name="Line1TextBox"
                                         Text="{Binding InputLine1, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8" ToolTip="Enter = Uebertragen (naechstes Etikett)">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ApplyCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- Zeile 2 (nur bei zweizeiligen Formaten) -->
                                <StackPanel Visibility="{Binding IsDoubleLine,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Label Content="Zeile 2:" Padding="0" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding InputLine2, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8" ToolTip="Enter = Uebertragen (naechstes Etikett)">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ApplyCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </StackPanel>

                                <!-- Uebertragen-Button -->
                                <Button Content="Uebertragen (naechstes Etikett)"
                                        Command="{Binding ApplyCommand}"
                                        FontWeight="Bold"
                                        Padding="10,8"
                                        Background="#0078D4"
                                        Foreground="White"
                                        Margin="0,5,0,0"/>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab 3: ET200MP Modul-Editor (nur bei modulbasierten Formaten) -->
                        <TabItem Header="MP Modul"
                                 Visibility="{Binding IsModuleBased, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="5">
                                <Label Content="Modul:" Padding="0" Margin="0,0,0,2" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedMpModuleInfo, Mode=OneWay}"
                                           Foreground="#0078D4" Margin="0,0,0,8"/>

                                <Label Content="Siemens-Modul:" Padding="0" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableMpArticles}"
                                          SelectedItem="{Binding SelectedMpArticle}"
                                          Margin="0,0,0,8">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                                <Run Text="{Binding ArticleNo, Mode=OneWay}" Foreground="Gray" FontSize="10"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Label Content="Modulvariante (Layout):" Padding="0" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableMpVariants}"
                                          SelectedItem="{Binding SelectedMpVariant}"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,0,8"/>

                                <Label Content="Header (Device / Module / Slot):" Padding="0" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedMpModule.HeaderText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="50" TextWrapping="Wrap"
                                         Margin="0,0,0,8"/>

                                <Label Content="Netzadresse (Block 1):" Padding="0" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedMpModule.NetAddress1, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,4"/>

                                <Label Content="Netzname (Block 2):" Padding="0" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedMpModule.NetAddress2, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,4"/>

                                <Label Content="CPU-Name:" Padding="0" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedMpModule.CpuName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"/>

                                <CheckBox Content="Modul drucken"
                                          IsChecked="{Binding SelectedMpModule.IsPrintEnabled}"
                                          Margin="0,0,0,4"
                                          ToolTip="Abgewaehlte Module werden nicht gedruckt (Vorschau: ausgegraut)"/>

                                <Separator Margin="0,4"/>

                                <Label Content="Ausgewaehlte Adresszelle:" Padding="0" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedMpCell.Text, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,4"
                                         IsEnabled="{Binding SelectedMpCell, Converter={StaticResource NullToBoolConverter}}"/>
                            </StackPanel>
                        </TabItem>

                    </TabControl>

                    <!-- Seite: globale Einstellungen (Kopfzeilen-Schrift, Raender, Kalibrierung, Blanko) -->
                    <GroupBox Header="Seite (gilt fuer alle Etiketten)" Margin="0,0,0,10">
                        <StackPanel Margin="5">
                            <!-- Header-Schrift (global) -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kopfzeile:" VerticalAlignment="Center" Margin="0,0,10,0"
                                           ToolTip="Schriftgroesse der Kopfzeile (SP) bzw. des Modul-Headers (MP), Punkt"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding FontSizes}"
                                          SelectedItem="{Binding InputHeaderFontSize}"/>
                                <CheckBox Grid.Column="2" Content="fett" IsChecked="{Binding InputHeaderIsBold}"
                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <!-- Seitenraender -->
                            <TextBlock Text="Seitenraender (mm, 0-60):" FontWeight="SemiBold" Margin="0,4,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Oben:" VerticalAlignment="Center" Margin="0,2"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InputMarginTop, StringFormat={}{0:0.0}}" Margin="5,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Rechts:" VerticalAlignment="Center" Margin="0,2"/>
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding InputMarginRight, StringFormat={}{0:0.0}}" Margin="5,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Links:" VerticalAlignment="Center" Margin="0,2"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InputMarginLeft, StringFormat={}{0:0.0}}" Margin="5,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Unten:" VerticalAlignment="Center" Margin="0,2"/>
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding InputMarginBottom, StringFormat={}{0:0.0}}" Margin="5,2"
                                         IsEnabled="{Binding IsMarginBottomEditable}"
                                         ToolTipService.ShowOnDisabled="True"
                                         ToolTip="ET200MP: Der Streifenbogen wird von oben gerastert (feste Zeilenhoehen), der untere Rand ergibt sich daraus."/>
                            </Grid>

                            <!-- Druckkalibrierung -->
                            <TextBlock Text="Druckkalibrierung (mm, +/-10):" FontWeight="SemiBold" Margin="0,6,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,2"
                                           ToolTip="Horizontaler Versatz: positiv=rechts, negativ=links"/>
                                <TextBox Grid.Column="1" Text="{Binding CalibrationOffsetX, StringFormat={}{0:0.0}}" Margin="5,2"
                                         ToolTip="Horizontaler Versatz in mm"/>
                                <TextBlock Grid.Column="3" Text="Y:" VerticalAlignment="Center" Margin="0,2"
                                           ToolTip="Vertikaler Versatz: positiv=unten, negativ=oben"/>
                                <TextBox Grid.Column="4" Text="{Binding CalibrationOffsetY, StringFormat={}{0:0.0}}" Margin="5,2"
                                         ToolTip="Vertikaler Versatz in mm"/>
                            </Grid>
                            <Button Content="Testseite drucken (Fadenkreuze)"
                                    Command="{Binding PrintCalibrationCommand}"
                                    Padding="8,4" Margin="0,4,0,0" FontSize="11"
                                    ToolTip="Druckt Fadenkreuze an den Ecken des Etikettenrasters. Auf Normalpapier drucken und mit Siemens-Blatt vergleichen."/>

                            <CheckBox Content="Blanko A4 (alle Rahmen drucken)"
                                      IsChecked="{Binding PrintGridLines}"
                                      Margin="0,8,0,4" FontSize="11"
                                      ToolTip="Aktivieren fuer Druck auf Blanko-A4-Papier (z.B. 120g Karton, hellblau = Standard, gelb = Safety). Druckt Schnittkanten + Rahmen um Adressen + Kopfzeile. Deaktiviert fuer perforierte Siemens-Etikettenboegen."/>

                            <Button Content="Seite zuruecksetzen (Raender, Kopfzeile)" Padding="10,4" Margin="0,4,0,0" FontSize="11"
                                    Command="{Binding ResetSettingsCommand}"
                                    ToolTip="Raender und Schrift-Einstellungen auf die Standardwerte der Produktfamilie"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Ausgewaehltes Etikett/Modul: Schrift (Live-Apply) -->
                    <GroupBox Margin="0,0,0,10">
                        <GroupBox.Header>
                            <TextBlock>
                                <Run Text="Schrift: "/>
                                <Run Text="{Binding EditTargetInfo, Mode=OneWay}" Foreground="#0078D4"/>
                            </TextBlock>
                        </GroupBox.Header>
                        <StackPanel Margin="5">
                            <TextBlock Text="Aenderungen wirken sofort auf das ausgewaehlte Etikett bzw. Modul."
                                       FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableFonts}"
                                      SelectedItem="{Binding InputFontFamily}"
                                      MaxDropDownHeight="300"
                                      Margin="0,0,0,5"
                                      ToolTip="Schriftart (alle installierten Windows-Schriften)">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="12"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Groesse:" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Schriftgroesse der Adressen in Punkt"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding FontSizes}"
                                          SelectedItem="{Binding InputFontSize}"/>
                                <CheckBox Grid.Column="2" Content="fett" IsChecked="{Binding InputIsBold}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <CheckBox Grid.Column="3" Content="kursiv" IsChecked="{Binding InputIsItalic}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Button Content="Auf alle Etiketten/Module anwenden" Padding="10,4" FontSize="11"
                                    Command="{Binding ApplyFontToAllCommand}"
                                    ToolTip="Diese Schrift-Einstellungen auf alle Etiketten bzw. Module aller Seiten uebertragen"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Loeschen -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Auswahl leeren" Command="{Binding ClearSelectedCommand}"
                                Padding="10,6" ToolTip="Ausgewaehltes Etikett/Modul leeren (Entf)"/>
                        <Button Content="Alle loeschen" Command="{Binding ClearAllCommand}"
                                Padding="10,6" Margin="8,0,0,0" ToolTip="Alle Etiketten/Module aller Seiten loeschen (mit Rueckfrage)"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- RECHTS: A4-Vorschau -->
            <Border x:Name="PreviewHost" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Background="#E0E0E0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header mit Zoom -->
                    <StackPanel Grid.Row="0" Background="#D0D0D0" Margin="0,0,0,0">
                        <TextBlock Text="A4-Druckvorschau" FontWeight="Bold" Margin="10,5,10,2"/>
                        <Grid Margin="10,0,10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Zoom:" FontSize="11" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding Zoom}" Minimum="0.3" Maximum="4"
                                    TickFrequency="0.5" IsSnapToTickEnabled="False" Margin="5,0"
                                    ToolTip="Strg + Mausrad ueber der Vorschau zoomt ebenfalls"/>
                            <TextBlock Grid.Column="2" Text="{Binding Zoom, StringFormat={}{0:0.00}x}"
                                       FontSize="11" VerticalAlignment="Center" Width="40"/>
                            <Button Grid.Column="3" Content="Ganze Seite" Click="FitZoom_Click" Padding="6,1" FontSize="11"
                                    ToolTip="Zoom so setzen, dass die ganze A4-Seite sichtbar ist (Strg+0)"/>
                        </Grid>
                    </StackPanel>

                    <!-- Page Navigation Bar -->
                    <Border Grid.Row="1" Background="#E8E8E8" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                            <Button Content="&#9664;" Command="{Binding PrevPageCommand}" Padding="8,2"
                                    ToolTip="Vorherige Seite (Ctrl+Bild auf)" FontSize="12"/>
                            <TextBlock Text="{Binding PageIndicator}" VerticalAlignment="Center"
                                       Margin="10,0" FontWeight="SemiBold" FontSize="12"/>
                            <Button Content="&#9654;" Command="{Binding NextPageCommand}" Padding="8,2"
                                    ToolTip="Naechste Seite (Ctrl+Bild ab)" FontSize="12"/>
                            <Button Content="+ Seite" Command="{Binding AddPageCommand}" Padding="8,2"
                                    Margin="15,0,0,0" ToolTip="Seite hinzufuegen"/>
                            <Button Content="- Seite" Command="{Binding RemovePageCommand}" Padding="8,2"
                                    Margin="5,0,0,0" ToolTip="Seite entfernen"/>
                        </StackPanel>
                    </Border>

                    <!-- A4-Blatt: ET200SP Preview (UniformGrid) -->
                    <ScrollViewer x:Name="SpScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="Preview_PreviewMouseWheel"
                                  Visibility="{Binding IsModuleBased, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                            </Border.LayoutTransform>
                            <!-- A4-Papier (210x297mm bei 3px/mm = 630x891px) -->
                            <Border Background="White"
                                    BorderBrush="#808080"
                                    BorderThickness="1"
                                    Width="630" Height="891"
                                    Padding="0">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="3" Opacity="0.3"/>
                                </Border.Effect>

                                <!-- Etikettenraster fuellt exakt den Druckbereich (PreviewMargin);
                                     Zeilennummern liegen daneben im rechten Seitenrand.
                                     Layout wie physisches A4-Blatt 6ES7193-6LA10-0AA0 -->
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding Labels}" Margin="{Binding PreviewMargin}">
                                    <!-- Grid spiegeln: unten-rechts = erste Position -->
                                    <ItemsControl.LayoutTransform>
                                        <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                                    </ItemsControl.LayoutTransform>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding LabelsPerRow}"
                                                         Rows="{Binding TotalVisualRows}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#A0A0A0"
                                                    BorderThickness="0.5"
                                                    Margin="0"
                                                    Cursor="Hand"
                                                    Opacity="{Binding PrintOpacity}"
                                                    MouseLeftButtonDown="Label_Click"
                                                    PreviewMouseRightButtonDown="Label_RightClick">
                                                <!-- Zurueck-spiegeln damit Inhalt lesbar bleibt -->
                                                <Border.LayoutTransform>
                                                    <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                                                </Border.LayoutTransform>
                                                <!-- ContextMenu haengt nicht im Visual Tree: Commands ueber den BindingProxy -->
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Kopieren"
                                                                  InputGestureText="Strg+C"
                                                                  Command="{Binding Data.CopyCommand, Source={StaticResource Proxy}}"/>
                                                        <MenuItem Header="Einfuegen"
                                                                  InputGestureText="Strg+V"
                                                                  Command="{Binding Data.PasteCommand, Source={StaticResource Proxy}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Druck umschalten" Click="TogglePrint_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F0F0F0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasText}" Value="True">
                                                                <Setter Property="Background" Value="#D0E8D0"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#E0E8F0"/>
                                                            </Trigger>
                                                            <!-- Multi-Selection: orange Rahmen (Strg+Klick / Shift+Klick) -->
                                                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                                <Setter Property="Background" Value="#FFF0D0"/>
                                                                <Setter Property="BorderBrush" Value="#FF9500"/>
                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                            </DataTrigger>
                                                            <!-- Single-Selection: blauer Rahmen (hat Prioritaet) -->
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#B8D4F0"/>
                                                                <Setter Property="BorderBrush" Value="#0078D4"/>
                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid ClipToBounds="True">
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Header-Spalte: Breite aus SheetGeometry (0 ohne Kopfzeile),
                                                             Bindung ueber Proxy (ColumnDefinition ist kein Visual) -->
                                                        <ColumnDefinition Width="{Binding Data.SpHeaderPreviewWidth, Source={StaticResource Proxy}}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Header-Spalte (90 Grad gedreht) -->
                                                    <Border Grid.Column="0" Background="#D8D8E8"
                                                            BorderBrush="#A0A0A0" BorderThickness="0,0,0.5,0"
                                                            Visibility="{Binding DataContext.HasHeader,
                                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <!-- Shrink-to-fit wie im Druck (PrintService.FitBox) -->
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                                            <TextBlock Text="{Binding Header}"
                                                                       FontSize="{Binding DataContext.HeaderPreviewFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       FontFamily="{Binding PreviewFontFamily}"
                                                                       FontWeight="{Binding DataContext.HeaderPreviewFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       Foreground="#4A148C">
                                                                <TextBlock.LayoutTransform>
                                                                    <RotateTransform Angle="-90"/>
                                                                </TextBlock.LayoutTransform>
                                                            </TextBlock>
                                                        </Viewbox>
                                                    </Border>

                                                    <!-- Textinhalt -->
                                                    <Grid Grid.Column="1">
                                                        <!-- HORIZONTAL: Einfache Textzeilen -->
                                                        <StackPanel VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="1">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsVertical,
                                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <!-- Leerslots entfernt (Line1Display), shrink-to-fit wie im Druck -->
                                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="90">
                                                                <TextBlock Text="{Binding Line1Display}"
                                                                           FontSize="{Binding PreviewFontSize}"
                                                                           FontWeight="{Binding PreviewFontWeight}"
                                                                           FontStyle="{Binding PreviewFontStyle}"
                                                                           FontFamily="{Binding PreviewFontFamily}"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="#1A237E"/>
                                                            </Viewbox>
                                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="90">
                                                                <Viewbox.Style>
                                                                    <!-- Einzeilige Formate drucken Line2 nicht — Preview = Druck -->
                                                                    <Style TargetType="Viewbox">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsDoubleLine,
                                                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                         Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Viewbox.Style>
                                                                <TextBlock Text="{Binding Line2Display}"
                                                                           FontSize="{Binding PreviewFontSize}"
                                                                           FontWeight="{Binding PreviewFontWeight}"
                                                                           FontStyle="{Binding PreviewFontStyle}"
                                                                           FontFamily="{Binding PreviewFontFamily}"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="#37474F"/>
                                                            </Viewbox>
                                                        </StackPanel>

                                                        <!-- VERTIKAL: Einzelne Adress-Rechtecke pro Zeile -->
                                                        <Grid Margin="0">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsVertical,
                                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <!-- Einzeilige Formate: untere Reihe auf 0 (Druck rendert dort
                                                                     nur bei RowsPerLabel >= 2) — Preview = Druck. Bindung ueber
                                                                     den Proxy, da RowDefinition kein Visual-Tree-Element ist. -->
                                                                <RowDefinition Height="{Binding Data.Line2RowHeight, Source={StaticResource Proxy}}"/>
                                                            </Grid.RowDefinitions>
                                                            <!-- Zeile 1: Ungerade Bits / Analog-Adressen -->
                                                            <ItemsControl Grid.Row="0" ItemsSource="{Binding Line1Parts}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border BorderBrush="#A0A0A0" BorderThickness="0.3"
                                                                                Margin="0">
                                                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                                                                <TextBlock Text="{Binding}"
                                                                                           FontSize="{Binding DataContext.PreviewFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                           FontWeight="{Binding DataContext.PreviewFontWeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                           FontStyle="{Binding DataContext.PreviewFontStyle, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                           FontFamily="{Binding DataContext.PreviewFontFamily, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                           Foreground="#1A237E">
                                                                                    <TextBlock.LayoutTransform>
                                                                                        <RotateTransform Angle="-90"/>
                                                                                    </TextBlock.LayoutTransform>
                                                                                </TextBlock>
                                                                            </Viewbox>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- Zeile 2: Gerade Bits (digital) oder leere Platzhalter (analog) -->
                                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding EffectiveLine2Parts}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border BorderBrush="#A0A0A0" BorderThickness="0.3"
                                                                                Margin="0">
                                                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                                                                <TextBlock Text="{Binding}"
                                                                                           FontSize="{Binding DataContext.PreviewFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                           FontWeight="{Binding DataContext.PreviewFontWeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                           FontStyle="{Binding DataContext.PreviewFontStyle, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                           FontFamily="{Binding DataContext.PreviewFontFamily, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                           Foreground="#37474F">
                                                                                    <TextBlock.LayoutTransform>
                                                                                        <RotateTransform Angle="-90"/>
                                                                                    </TextBlock.LayoutTransform>
                                                                                </TextBlock>
                                                                            </Viewbox>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                    <!-- Zeilennummern im rechten Seitenrand (wie physisches A4-Blatt) -->
                                    <ItemsControl ItemsSource="{Binding RowNumbers}"
                                                  Margin="{Binding RowNumbersMargin}"
                                                  HorizontalAlignment="Left" Width="14">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="{Binding TotalVisualRows}" Columns="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontSize="7"
                                                           Foreground="#808080"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Margin="1,0,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </Grid>
                            </Border>
                        </Border>
                    </ScrollViewer>

                    <!-- A4-Blatt: ET200MP Preview (Canvas-basiert) -->
                    <ScrollViewer x:Name="MpScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="Preview_PreviewMouseWheel"
                                  Visibility="{Binding IsModuleBased, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                            </Border.LayoutTransform>
                            <Border Background="White"
                                    BorderBrush="#808080"
                                    BorderThickness="1"
                                    Width="630" Height="891"
                                    Padding="0">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="3" Opacity="0.3"/>
                                </Border.Effect>
                                <controls:MpPreviewControl x:Name="MpPreview" DataContext="{Binding}">
                                    <controls:MpPreviewControl.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Kopieren" InputGestureText="Strg+C"
                                                      Command="{Binding Data.CopyCommand, Source={StaticResource Proxy}}"/>
                                            <MenuItem Header="Einfuegen" InputGestureText="Strg+V"
                                                      Command="{Binding Data.PasteCommand, Source={StaticResource Proxy}}"/>
                                            <Separator/>
                                            <MenuItem Header="Druck umschalten (ausgewaehltes Modul)"
                                                      Command="{Binding Data.TogglePrintCommand, Source={StaticResource Proxy}}"/>
                                        </ContextMenu>
                                    </controls:MpPreviewControl.ContextMenu>
                                </controls:MpPreviewControl>
                            </Border>
                        </Border>
                    </ScrollViewer>

                </Grid>
            </Border>

        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusSelectionInfo, Mode=OneWay}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding PageIndicator, Mode=OneWay}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedFormat.DisplayName, Mode=OneWay}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedProductFamilyInfo.LabelSheetPartNumber, Mode=OneWay}"
                           Foreground="Gray" ToolTip="Beschriftungsbogen-Artikelnummer"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
