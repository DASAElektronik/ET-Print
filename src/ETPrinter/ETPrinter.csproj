<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ET-Printer</AssemblyName>
    <Version>3.1.0</Version>
    <Company>DASA</Company>
    <Description>Beschriftungsstreifen fuer Siemens ET 200SP und S7-1500/ET 200MP auf A4 drucken</Description>
    <ApplicationIcon>Assets/ETPrinter.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ETPrinter.Tests" />
  </ItemGroup>

</Project>
